{
  "name": "hosstock",
  "private": true,
  "description": "Hosstock: hospital inventory and procurement management platform",
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:setup": "npm run db:setup -w apps/backend",
    "etl": "npm run etl -w apps/backend",
    "dev:backend": "npm run start:dev -w apps/backend",
    "dev:frontend": "npm run dev -w apps/frontend",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w apps/backend"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher": false
  }
}
