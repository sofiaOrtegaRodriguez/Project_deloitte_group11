// Hosstock database schema. Vocabulary follows GLOSSARY.md.
//
// Source tables (Snapshot, Vendor) are fully replaced by every ETL run.
// Item is upserted by its natural key so its internal id stays stable across runs (ADR 0001),
// which lets application tables added later reference Items safely.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  /// Partial unique indexes (`where:`) for the User rules.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// An Item is the pair (Item_ID, Item_Name) from the inventory CSV (ADR 0001).
model Item {
  id                Int                @id @default(autoincrement())
  /// `Item_ID` column of the source CSV.
  sourceItemId      Int                @map("source_item_id")
  /// `Item_Name` column of the source CSV.
  name              String
  /// Category (`Item_Type`) taken from the Item's latest Snapshot.
  category          String
  /// Vendor (`Vendor_ID`) taken from the Item's latest Snapshot.
  vendorCode        String             @map("vendor_code")
  snapshots         Snapshot[]
  thresholdOverride ThresholdOverride?

  @@unique([sourceItemId, name])
  @@map("items")
}

/// Global settings: a single row (id = 1), enforced by a CHECK constraint. Application table, never touched
/// by the ETL. When the row is missing, the defaults below apply (see src/settings/settings.service.ts).
model Settings {
  id                   Int       @id @default(1)
  /// Reference Date. Null means "the last date in the dataset".
  referenceDate        DateTime? @map("reference_date") @db.Date
  /// Cumulative share of Stock Value (%) covered by ABC class A.
  abcThresholdA        Float     @default(80) @map("abc_threshold_a")
  /// Cumulative share of Stock Value (%) covered by ABC classes A and B.
  abcThresholdB        Float     @default(95) @map("abc_threshold_b")
  urgencyFactor        Float     @default(0.5) @map("urgency_factor")
  /// ABC Classes that can make an Item Critical (letters A, B, C).
  criticalAbcClasses   String[]  @default(["A", "B"]) @map("critical_abc_classes")
  /// Stock Turnover per year below which an Item is a Low-Turnover Item.
  lowTurnoverThreshold Float     @default(12) @map("low_turnover_threshold")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}

/// A Director-set Min Required and/or Max Capacity for an Item. A null side means "no override".
/// Application table, never touched by the ETL.
model ThresholdOverride {
  id          Int      @id @default(autoincrement())
  itemId      Int      @unique @map("item_id")
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  minRequired Decimal? @map("min_required") @db.Decimal
  maxCapacity Decimal? @map("max_capacity") @db.Decimal
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("threshold_overrides")
}

/// One change to the configuration (settings or a Threshold Override): when, who, and what went from old to new.
/// `changes` is a list of `{ field, old, new }`. Application table, never touched by the ETL.
model ConfigurationLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// The User's name at the time of the change.
  userName  String   @map("user_name")
  changes   Json

  @@map("configuration_log")
}

/// One row of the inventory CSV: the state of an Item on a date. Loaded unchanged: rows are never
/// dropped or corrected, and inconsistent values get Data Quality Flags (ADR 0002).
/// Numbers are unconstrained NUMERIC so every digit of the source is kept, with no rounding.
model Snapshot {
  id                    Int      @id @default(autoincrement())
  itemId                Int      @map("item_id")
  item                  Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  date                  DateTime @db.Date
  category              String
  vendorCode            String   @map("vendor_code")
  currentStock          Decimal  @map("current_stock") @db.Decimal
  minRequired           Decimal  @map("min_required") @db.Decimal
  maxCapacity           Decimal  @map("max_capacity") @db.Decimal
  unitCost              Decimal  @map("unit_cost") @db.Decimal
  avgUsagePerDay        Decimal  @map("avg_usage_per_day") @db.Decimal
  /// Replenishment Time in days (`Restock_Lead_Time` column of the CSV).
  replenishmentTimeDays Decimal  @map("replenishment_time_days") @db.Decimal

  /// Data Quality Flag: Current_Stock > Max_Capacity.
  stockAboveMaxCapacity Boolean @map("stock_above_max_capacity")
  /// Data Quality Flag: Min_Required > Max_Capacity.
  minAboveMax           Boolean @map("min_above_max")
  /// Data Quality Flag: a stock, threshold, cost, usage or Replenishment Time value is negative.
  negativeValue         Boolean @map("negative_value")
  /// Data Quality Flag: stock, a threshold or Replenishment Time is not a whole number.
  nonIntegerQuantity    Boolean @map("non_integer_quantity")
  /// Data Quality Flag: the dataset has more than one Snapshot for this Item on this date.
  duplicateSnapshot     Boolean @map("duplicate_snapshot")

  @@index([itemId, date])
  @@index([date])
  @@map("snapshots")
}

enum Role {
  DIRECTOR
  PROCUREMENT_TEAM
}

/// Whether a User can log in. Only Active Users can use Hosstock.
enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  REMOVED
}

/// A person who can use Hosstock, as the Director or as a Procurement Team member.
/// Application table: never touched by the ETL.
model User {
  id           Int           @id @default(autoincrement())
  name         String
  /// Stored lower-cased. Unique among Users that are not Rejected: a Rejected User frees the email.
  email        String
  passwordHash String        @map("password_hash")
  role         Role
  status       AccountStatus
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  configurationLogs ConfigurationLog[]

  /// There is exactly one Director.
  @@unique([role], map: "users_single_director", where: raw("role = 'DIRECTOR'"))
  /// An email belongs to at most one User that is not Rejected.
  @@unique([email], map: "users_email_not_rejected", where: raw("status <> 'REJECTED'"))
  @@index([email])
  @@map("users")
}

/// Vendor reference data. Only the name and Contracted Lead Time are used (ADR 0002).
model Vendor {
  code                   String @id
  name                   String
  /// Contracted Lead Time in days (`Avg_Lead_Time (days)` in vendor_data.csv).
  contractedLeadTimeDays Int    @map("contracted_lead_time_days")

  @@map("vendors")
}
