// Hosstock database schema. Vocabulary follows GLOSSARY.md.
//
// Source tables (Snapshot, Vendor) are fully replaced by every ETL run.
// Item is upserted by its natural key so its internal id stays stable across runs (ADR 0001),
// which lets application tables added later reference Items safely.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  /// Partial unique indexes (`where:`) for the User rules.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// An Item is the pair (Item_ID, Item_Name) from the inventory CSV (ADR 0001).
model Item {
  id                Int                @id @default(autoincrement())
  /// `Item_ID` column of the source CSV.
  sourceItemId      Int                @map("source_item_id")
  /// `Item_Name` column of the source CSV.
  name              String
  /// Category (`Item_Type`) taken from the Item's latest Snapshot.
  category          String
  /// Vendor (`Vendor_ID`) taken from the Item's latest Snapshot.
  vendorCode        String             @map("vendor_code")
  snapshots         Snapshot[]
  thresholdOverride ThresholdOverride?
  alerts            Alert[]
  recommendations   Recommendation[]

  @@unique([sourceItemId, name])
  @@map("items")
}

/// Global settings: a single row (id = 1), enforced by a CHECK constraint. Application table, never touched
/// by the ETL. When the row is missing, the defaults below apply (see src/settings/settings.service.ts).
model Settings {
  id                   Int       @id @default(1)
  /// Reference Date. Null means "the last date in the dataset".
  referenceDate        DateTime? @map("reference_date") @db.Date
  /// Cumulative share of Stock Value (%) covered by ABC class A.
  abcThresholdA        Float     @default(80) @map("abc_threshold_a")
  /// Cumulative share of Stock Value (%) covered by ABC classes A and B.
  abcThresholdB        Float     @default(95) @map("abc_threshold_b")
  urgencyFactor        Float     @default(0.5) @map("urgency_factor")
  /// ABC Classes that can make an Item Critical (letters A, B, C).
  criticalAbcClasses   String[]  @default(["A", "B"]) @map("critical_abc_classes")
  /// Stock Turnover per year below which an Item is a Low-Turnover Item.
  lowTurnoverThreshold Float     @default(12) @map("low_turnover_threshold")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}

/// A Director-set Min Required and/or Max Capacity for an Item. A null side means "no override".
/// Application table, never touched by the ETL.
model ThresholdOverride {
  id          Int      @id @default(autoincrement())
  itemId      Int      @unique @map("item_id")
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  minRequired Decimal? @map("min_required") @db.Decimal
  maxCapacity Decimal? @map("max_capacity") @db.Decimal
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("threshold_overrides")
}

/// One change to the configuration (settings or a Threshold Override): when, who, and what went from old to new.
/// `changes` is a list of `{ field, old, new }`. Application table, never touched by the ETL.
model ConfigurationLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// The User's name at the time of the change.
  userName  String   @map("user_name")
  changes   Json

  @@map("configuration_log")
}

/// One row of the inventory CSV: the state of an Item on a date. Loaded unchanged: rows are never
/// dropped or corrected, and inconsistent values get Data Quality Flags (ADR 0002).
/// Numbers are unconstrained NUMERIC so every digit of the source is kept, with no rounding.
model Snapshot {
  id                    Int      @id @default(autoincrement())
  itemId                Int      @map("item_id")
  item                  Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  date                  DateTime @db.Date
  category              String
  vendorCode            String   @map("vendor_code")
  currentStock          Decimal  @map("current_stock") @db.Decimal
  minRequired           Decimal  @map("min_required") @db.Decimal
  maxCapacity           Decimal  @map("max_capacity") @db.Decimal
  unitCost              Decimal  @map("unit_cost") @db.Decimal
  avgUsagePerDay        Decimal  @map("avg_usage_per_day") @db.Decimal
  /// Replenishment Time in days (`Restock_Lead_Time` column of the CSV).
  replenishmentTimeDays Decimal  @map("replenishment_time_days") @db.Decimal

  /// Data Quality Flag: Current_Stock > Max_Capacity.
  stockAboveMaxCapacity Boolean @map("stock_above_max_capacity")
  /// Data Quality Flag: Min_Required > Max_Capacity.
  minAboveMax           Boolean @map("min_above_max")
  /// Data Quality Flag: a stock, threshold, cost, usage or Replenishment Time value is negative.
  negativeValue         Boolean @map("negative_value")
  /// Data Quality Flag: stock, a threshold or Replenishment Time is not a whole number.
  nonIntegerQuantity    Boolean @map("non_integer_quantity")
  /// Data Quality Flag: the dataset has more than one Snapshot for this Item on this date.
  duplicateSnapshot     Boolean @map("duplicate_snapshot")

  @@index([itemId, date])
  @@index([date])
  @@map("snapshots")
}

enum Role {
  DIRECTOR
  PROCUREMENT_TEAM
}

/// Whether a User can log in. Only Active Users can use Hosstock.
enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  REMOVED
}

/// A person who can use Hosstock, as the Director or as a Procurement Team member.
/// Application table: never touched by the ETL.
model User {
  id                   Int                   @id @default(autoincrement())
  name                 String
  /// Stored lower-cased. Unique among Users that are not Rejected: a Rejected User frees the email.
  email                String
  passwordHash         String                @map("password_hash")
  role                 Role
  status               AccountStatus
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  recommendations      Recommendation[]
  recommendationEvents RecommendationEvent[]

  configurationLogs ConfigurationLog[]

  logAsAffected UserManagementLogEntry[] @relation("LogAffectedUser")
  logAsActor    UserManagementLogEntry[] @relation("LogActor")

  /// There is exactly one Director.
  alertEvents  AlertEvent[]
  notifications Notification[]

  @@unique([role], map: "users_single_director", where: raw("role = 'DIRECTOR'"))
  /// An email belongs to at most one User that is not Rejected.
  @@unique([email], map: "users_email_not_rejected", where: raw("status <> 'REJECTED'"))
  @@index([email])
  @@map("users")
}

/// Vendor reference data. Only the name and Contracted Lead Time are used (ADR 0002).
model Vendor {
  code                   String @id
  name                   String
  /// Contracted Lead Time in days (`Avg_Lead_Time (days)` in vendor_data.csv).
  contractedLeadTimeDays Int    @map("contracted_lead_time_days")

  @@map("vendors")
}

/// How urgent an Alert is. Mirrors the Critical and Attention Urgency Levels.
enum AlertLevel {
  CRITICAL
  ATTENTION
}

/// Where an Alert is in its lifecycle (see GLOSSARY.md). Only CLEARED is closed (ADR 0004).
enum AlertStatus {
  NEW
  VIEWED
  ACKNOWLEDGED
  IGNORED
  RESOLVED
  CLEARED
}

enum AlertEventType {
  CREATED
  ESCALATED
  LEVEL_LOWERED
  STATUS_CHANGED
  REOPENED
  CLEARED
  COMMENTED
}

/// A team-wide notice that an Item is Critical or Attention. An Item has at most one open Alert
/// (any status except CLEARED), enforced by a partial unique index. Application table, never touched by the ETL.
model Alert {
  id            Int         @id @default(autoincrement())
  itemId        Int         @map("item_id")
  item          Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  level         AlertLevel
  status        AlertStatus @default(NEW)
  /// Priority Score of the Item at the last recalculation, for ordering.
  priorityScore Float?      @map("priority_score")
  /// Reminders sent for this Alert (ticket 13).
  reminderCount Int         @default(0) @map("reminder_count")
  /// Why the Alert last Reopened, e.g. "expected delivery overdue" (ticket 17).
  reason        String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at")
  events        AlertEvent[]

  /// One open Alert per Item.
  @@unique([itemId], map: "alerts_one_open_per_item", where: raw("status <> CLEARED"))
  @@index([itemId])
  @@map("alerts")
}

/// Every transition and comment of an Alert. A null user means "system".
model AlertEvent {
  id         Int            @id @default(autoincrement())
  alertId    Int            @map("alert_id")
  alert      Alert          @relation(fields: [alertId], references: [id], onDelete: Cascade)
  type       AlertEventType
  fromStatus AlertStatus?   @map("from_status")
  toStatus   AlertStatus?   @map("to_status")
  fromLevel  AlertLevel?    @map("from_level")
  toLevel    AlertLevel?    @map("to_level")
  userId     Int?           @map("user_id")
  user       User?          @relation(fields: [userId], references: [id])
  /// Comment text, for COMMENTED events.
  comment    String?
  /// Extra context, e.g. "via Recommendation #12" or "expected delivery overdue".
  note       String?
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([alertId, createdAt])
  @@map("alert_events")
}

enum RecommendationType {
  REPLENISH
  HOLD_PURCHASES
}

/// Draft -> Pending Approval -> Approved | Rejected, plus Discarded (from Draft). Never deleted.
enum RecommendationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  DISCARDED
}

/// A proposal to buy (Replenish) or to stop buying (Hold Purchases) an Item. Application table.
model Recommendation {
  id                Int                   @id @default(autoincrement())
  type              RecommendationType
  status            RecommendationStatus  @default(DRAFT)
  itemId            Int                   @map("item_id")
  item              Item                  @relation(fields: [itemId], references: [id])
  /// Units to buy. Always 0 for Hold Purchases.
  quantity          Decimal               @db.Decimal
  /// quantity x unit cost. Always 0 for Hold Purchases (see figures.freedCapital).
  estimatedCost     Decimal               @map("estimated_cost") @db.Decimal
  priorityScore     Float?                @map("priority_score")
  justification     String
  /// The indicator figures the Recommendation was created with (compared with current ones for Stale Drafts).
  figures           Json
  /// Frozen copy saved when the Recommendation is submitted.
  indicatorSnapshot Json?                 @map("indicator_snapshot")
  /// Null when the system created it (auto-Draft).
  createdById       Int?                  @map("created_by_id")
  createdBy         User?                 @relation(fields: [createdById], references: [id])
  discardReason     String?               @map("discard_reason")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  events            RecommendationEvent[]

  /// At most one open Draft per Item and type.
  @@unique([itemId, type], map: "recommendations_one_open_draft", where: raw("status = DRAFT"))
  @@index([itemId])
  @@index([status])
  @@map("recommendations")
}

enum RecommendationEventType {
  CREATED
  EDITED
  DISCARDED
}

/// History of a Recommendation: who did what and when. A null user means the system.
model RecommendationEvent {
  id               Int                     @id @default(autoincrement())
  recommendationId Int                     @map("recommendation_id")
  recommendation   Recommendation          @relation(fields: [recommendationId], references: [id])
  type             RecommendationEventType
  userId           Int?                    @map("user_id")
  user             User?                   @relation(fields: [userId], references: [id])
  details          Json?
  createdAt        DateTime                @default(now()) @map("created_at")

  @@index([recommendationId])
  @@map("recommendation_events")
}

/// An access decision recorded in the User Management Log.
enum UserManagementAction {
  APPROVE
  REJECT
  REMOVE
  RESTORE
}

/// User Management Log: one row per approve, reject, remove or restore decision.
model UserManagementLogEntry {
  id             Int                  @id @default(autoincrement())
  createdAt      DateTime             @default(now()) @map("created_at")
  action         UserManagementAction
  /// The User the decision was about.
  affectedUserId Int                  @map("affected_user_id")
  /// Who decided. Nullable: not every entry has a known actor.
  actorId        Int?                 @map("actor_id")

  affectedUser User  @relation("LogAffectedUser", fields: [affectedUserId], references: [id], onDelete: Cascade)
  actor        User? @relation("LogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("user_management_log")
}

enum SimulationStatus {
  STOPPED
  RUNNING
  PAUSED
  /// Reached the end of the data; stays on the last date until the Director stops it.
  FINISHED
}

/// The single, global Simulation (spec "Simulation"). Row id 1; absent means STOPPED.
/// Application table, never touched by the ETL.
model SimulationState {
  id                    Int              @id @default(1)
  status                SimulationStatus @default(STOPPED)
  startDate             DateTime?        @map("start_date") @db.Date
  /// The simulated date: the Reference Date while the Simulation is not STOPPED.
  currentDate           DateTime?        @map("current_date") @db.Date
  secondsPerDay         Int              @default(10) @map("seconds_per_day")
  /// The Reference Date setting before the Simulation started (null = follow the dataset), restored on stop.
  previousReferenceDate DateTime?        @map("previous_reference_date") @db.Date
  /// Clock time of the last step (or of start/resume); the next step is due secondsPerDay later.
  lastStepAt            DateTime?        @map("last_step_at")

  @@map("simulation_state")
}

/// A per-User inbox entry (bell). Alerts are team-wide, so Alert events produce one row per Active User.
/// Access Requests never produce Notifications.
model Notification {
  id               Int              @id @default(autoincrement())
  userId           Int              @map("user_id")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             NotificationType
  alertId          Int?             @map("alert_id")
  itemId           Int?             @map("item_id")
  recommendationId Int?             @map("recommendation_id")
  message          String
  createdAt        DateTime         @default(now()) @map("created_at")
  readAt           DateTime?        @map("read_at")

  @@index([userId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  ALERT_CREATED
  ALERT_ESCALATED
  ALERT_REOPENED
  REMINDER
  DRAFT_STALE
  RECOMMENDATION_DECISION
}
