# Copy this file to `.env` (in the same folder) and fill in your own values.
# `.env` is never committed: it contains passwords.

# --- Database (PostgreSQL installed natively on your machine) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Replace YOUR_PASSWORD with the password you chose for the `postgres` user when installing PostgreSQL.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/hosstock"
# A separate database used only by the automated tests. It is wiped on every test run.
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/hosstock_test"

# --- Dataset ---
# Folder that contains inventory_data.csv and vendor_data.csv.
# Relative paths are resolved from the folder that contains this .env file.
DATASET_PATH="2-Hospital_Dataset"

# --- Backend ---
BACKEND_PORT=3001

# --- Authentication (used from ticket 02 onwards) ---
# A long random string used to sign login tokens. Change it to something only you know.
JWT_SECRET="change-me-to-a-long-random-string"

# The Director is created automatically from these values the first time the backend starts.
# The backend refuses to start while JWT_SECRET or DIRECTOR_PASSWORD keep the example values below.
DIRECTOR_NAME="Director of Procurement"
DIRECTOR_EMAIL="director@hospital.example"
DIRECTOR_PASSWORD="change-me-please"

# --- Alerts and live monitor (used by later tickets) ---
# Hours between Reminders for Alerts whose Item is still Critical or Attention.
ALERT_REPEAT_HOURS=12
# Seconds between refreshes of the live monitor.
LIVE_MONITOR_REFRESH_SECONDS=30
